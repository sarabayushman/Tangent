       <property name="styleSheet">
        <string notr="true">/*border: 1px solid  rgba(20,30,20,0.8);
background-color: transparent;
padding: 2px;
font-size: 13px;
border-radius: 5px;*/



/* The main combo box button */
QComboBox {
    border: 1px solid rgb(200,200,200);
    border-radius: 6px;
    padding: 8px 12px;
    background-color: white;
    color: #333333;
    font-size: 13px;
    min-height: 12px;
	max-height: 12px;
}

QComboBox:hover {
    border: 1px solid rgb(180,180,180);
}

QComboBox:on { /* When the dropdown is open */
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
    background-color: #F5F5F5;
}

/* The arrow button */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left-width: 0px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}



/* The dropdown menu container (QAbstractItemView) */
QComboBox QAbstractItemView {
    background-color: white;
    border: 1px solid #E0E0E0;
    border-top: none;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding: 4px;
    selection-background-color: #E3F2FD; /* Light blue selection */
    selection-color: #333333;
    outline: 0px; /* Removes dotted line */
}

/* Item Styling */
QComboBox QAbstractItemView::item {
    min-height: 30px; /* Space out items */
    border-radius: 4px;
}

/* Hovered Item */
QComboBox QAbstractItemView::item:hover {
    background-color: #F5F5F5;
    color: #000000;
}

/* Selected Item */
QComboBox QAbstractItemView::item:selected {
    background-color: #E3F2FD;
    color: #000000;
}


QComboBox::down-arrow {
        image: url(&quot;./res/_icon_drpdwn.png&quot;); /* Use a modern custom icon */
        width: 12px;
        height: 12px;
    }
</string>

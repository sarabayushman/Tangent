  <property name="styleSheet">
   <string notr="true">/* --- Modern Scrollbar Style --- */

/* --- QLabel Styling --- */
QLabel {
    color: rgb(40,40,40);
    font-size: 15px;
    font-weight: 400;
    background: transparent;
    padding: 4px;
}

/* Optional: A specific heading style if you use setObjectName(&quot;header&quot;) */
QLabel#header {
    font-size: 18px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 5px;
}

/* Optional: A &quot;status&quot; badge style if you use setObjectName(&quot;badge&quot;) */
QLabel#badge {
    background-color: #444;
    border-radius: 10px;
    padding: 2px 10px;
    color: #3d5afe;
    font-size: 12px;
}


/* --- QLineEdit &amp; QTextEdit --- */
QLineEdit, QTextEdit {
    background-color: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #0078d4;
    selection-color: white;
}

QLineEdit:hover, QTextEdit:hover {
    border: 1px solid #a6a6a6;
}

QLineEdit:focus, QTextEdit:focus {
    border: 2px solid #0078d4;
    background-color: #ffffff;
}


/* Modern PushButton */
QPushButton {
    background-color: #3a3a3a;
    color: #ffffff;
    border: none;
    border-radius: 5px;
    padding: 6px 10px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #505050;
}
QPushButton:pressed {
    background-color: #202020;
}



/* Vertical Scrollbar */
QScrollBar:vertical {
    border: none;
    background: #f1f1f1; /* Track color */
    width: 10px;          /* Width of vertical bar */
    margin: 0px 0px 0px 0px;
    border-radius: 5px;   /* Rounded track */
}

QScrollBar::handle:vertical {
    background: #c1c1c1;  /* Thumb color */
    min-height: 20px;
    border-radius: 5px;   /* Rounded handle */
}

QScrollBar::handle:vertical:hover {
    background: #a8a8a8;  /* Hover color */
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;          /* Hide arrows */
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;     /* No background on track pieces */
}

/* Horizontal Scrollbar */
QScrollBar:horizontal {
    border: none;
    background: #f1f1f1; /* Track color */
    height: 5px;         /* Height of horizontal bar */
    margin: 0px 0px 0px 0px;
    border-radius: 5px;   /* Rounded track */
}

QScrollBar::handle:horizontal {
    background: #c1c1c1;  /* Thumb color */
    min-width: 20px;
    border-radius: 5px;   /* Rounded handle */
}

QScrollBar::handle:horizontal:hover {
    background: #a8a8a8;  /* Hover color */
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;           /* Hide arrows */
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;     /* No background on track pieces */
}
</string>

    <widget class="QTabWidget" name="tabWidget">
     <property name="styleSheet">
      <string notr="true">/* The main background of the settings window */
QWidget#SettingsWindow {
    background-color: #FAFAFA;
}

/* The background pane for settings content */
QTabWidget::pane {
    border: 1px solid #E0E0E0;
    background-color: #FFFFFF;
    border-radius: 6px;
border:none;
}

/* Style the horizontal tab bar */
QTabBar::tab {
    background-color: white;
	padding: 0px 12px;
    margin-right: 2px;
    color: black;
    font-size: 14px;
	width: 50px;
    height: 22px;
    margin-bottom: 10px;
    border-radius: 10px;
    border: 1px solid black;
}

/* Inactive tab hover effect */
QTabBar::tab:hover:!selected {
    background-color: #E8E8E8;
    color: #222222;
}

/* Active/Selected tab */
QTabBar::tab:selected {
color: white;
background-color: black;
}

/* Style for settings labels inside the tab */
QLabel {
    color: #464D55;
    font-size: 13px;
}
</string>
